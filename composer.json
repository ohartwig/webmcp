{
    "name": "koh/webmcp",
    "description": "WebMCP (Web Model Context Protocol) integration for TYPO3 — exposes structured tools (search, navigation, content) to AI agents via navigator.modelContext.",
    "type": "typo3-cms-extension",
    "license": "MIT",
    "homepage": "https://ole-hartwig.eu/open-source/webmcp",
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu",
            "homepage": "https://ole-hartwig.eu",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/ohartwig/webmcp/issues",
        "source": "https://github.com/ohartwig/webmcp",
        "security": "https://github.com/ohartwig/webmcp/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.5.11",
        "typo3/cms-backend": "^13.4 || ^14.0",
        "typo3/cms-core": "^13.4 || ^14.0",
        "typo3/cms-frontend": "^13.4 || ^14.0"
    },
    "require-dev": {
        "koh/dev-typo3": "^1.0",
        "typo3/cms-form": "^13.4 || ^14.0"
    },
    "suggest": {
        "typo3/cms-form": "Required for the Form Tool integration (submitting TYPO3 forms via WebMCP)"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/175/-/packages/composer/packages.json",
            "only": [
                "hn/typo3-mcp-server",
                "netresearch/nr-passkeys-be"
            ]
        },
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ],
    "autoload": {
        "psr-4": {
            "Koh\\WebMcp\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\WebMcp\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "webmcp"
        }
    },
    "scripts": {
        "deptrac": "deptrac analyse",
        "phpstan": "phpstan analyse",
        "test": "phpunit -c Tests/phpunit.xml --testsuite Unit",
        "test:functional": "phpunit -c Tests/phpunit.xml --testsuite Functional"
    }
}
